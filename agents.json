{
  "name": "canada-ai-components",
  "description": "Canada.ca Design System registry for AI coding agents. Self-contained, accessible Government of Canada components with bilingual (EN/FR) metadata and full adaptation/coordination support.",
  "repo": "https://github.com/ednark/canada-ai-components",
  "base": "https://raw.githubusercontent.com/ednark/canada-ai-components/main",
  "count": 25,
  "facetsUrl": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/infinite/facets.json",
  "index": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/infinite/components.index.json",
  "indexSchemaVersion": 1,
  "metadataSchemaVersion": 2,
  "tileFetchPattern": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/infinite/{file}",
  "designSystem": {
    "name": "Canada.ca (WET-BOEW + GC Design System)",
    "version": "19.6.0"
  },
  "agentMetaId": "canada-agent-meta",
  "tileDir": "infinite",
  "facets": [
    "canadaComponentType",
    "section",
    "variant",
    "requiresJs",
    "interaction",
    "a11y",
    "govCompliance",
    "costTier",
    "compositionRecipes",
    "languages",
    "piiHandling",
    "touchTargetSize",
    "supportedTokenProfiles"
  ],
  "flow": [
    "GET agents.json",
    "GET facets.json",
    "GET components.index.json",
    "filter by facet in code",
    "GET tile by file",
    "read canada-agent-meta block"
  ],
  "recipesUrl": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/infinite/recipes/index.json",
  "versionsUrl": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/infinite/versions.json",
  "compatibilityUrl": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/compatibility.json",
  "compatibilityTargets": [
    "uswds",
    "govuk",
    "dsfr"
  ],
  "mcp": {
    "enabled": true,
    "server": "_base/mcp/server.mjs",
    "transport": "stdio",
    "tools": [
      "search_components",
      "get_component",
      "list_facets",
      "get_index",
      "get_adapter",
      "translate_component",
      "get_recipe",
      "query_compliance",
      "get_versions"
    ]
  },
  "compatibilityPath": "compatibility.json",
  "updated": "0.1.0",
  "contentLanguages": [
    "en",
    "fr"
  ],
  "appearance": "Every tile has a generated resolved view: fetch {tileDir}/{file with .html replaced by .resolved.html} for a computed-style standalone rendering (geometry + colors inline, validated at build time). Index records expose the path as the resolvedView field. Tiles carry their component CSS inline.",
  "healthUrl": "https://raw.githubusercontent.com/ednark/canada-ai-components/main/registry-health.json"
}
